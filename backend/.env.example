# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
# anon / publishable key (safe for clients; respects RLS)
SUPABASE_PUBLISHABLE_KEY=
# service_role / secret key (server-only; bypasses RLS) — backend uses this
SUPABASE_SECRET_KEY=
# e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Browser origins allowed to call the API (comma-separated). Defaults to the
# Vite dev server: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=